{
  "name": "lean4-harness-plugin",
  "version": "0.1.0",
  "description": "Lean 4 service and Harness tools for deepseek-harness.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dsh": {
      "import": "./dsh-plugin.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js tests/*.test.mjs",
    "check": "npm run build",
    "prepare": "npm run build"
  },
  "files": [
    "dist/",
    "dsh-plugin.js",
    "cordis.patch.yml",
    "lean/lean-toolchain",
    "lean/lakefile.lean",
    "lean/lake-manifest.json",
    "lean/Lean4Harness.lean",
    "lean/Main.lean",
    "lean/README.md",
    "skills/",
    "scripts/",
    "README.md",
    "docs/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "lean4",
    "deepseek-harness",
    "cordis",
    "formal-verification"
  ],
  "license": "MIT",
  "author": "ygw",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}
